{
  "name": "smart-tv-signage",
  "version": "1.2.0",
  "description": "Multi-Channel LAN Digital Signage System for Smart TVs with Real-Time Screen Sharing, Slide Control, and Multi-Format Support",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build:exe": "node scripts/build-icon.js && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:winexe /win32icon:app.ico /out:SmartTV-Signage.exe /r:System.Windows.Forms.dll /r:System.Drawing.dll scripts\\SmartTV-Signage.cs",
    "package": "node scripts/package.js"
  },
  "keywords": [
    "digital-signage",
    "smart-tv",
    "screen-sharing",
    "fastify",
    "lan"
  ],
  "author": "mamabuncho <mamabuncho@gmail.com>",
  "copyright": "Copyright (c) 2026 mamabuncho. All rights reserved.",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "music-metadata": "^7.14.0",
    "pdfjs-dist": "^6.5.438",
    "puppeteer-core": "^25.17.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {}
}
